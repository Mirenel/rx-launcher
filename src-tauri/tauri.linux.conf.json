{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "Project Rx",
        "width": 1100,
        "height": 640,
        "minWidth": 720,
        "minHeight": 420,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "center": true
      }
    ]
  },
  "bundle": {
    "useLocalToolsDir": true,
    "targets": ["deb", "appimage", "rpm"],
    "linux": {
      "rpm": {
        "epoch": 0,
        "release": "1"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
